# API server
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Generate a private random token of at least 32 characters; server-side only.
NEXUS_ADMIN_TOKEN=
WEBSITE_URL=https://tinetech.onrender.com

# Google Gemini API — SERVER ONLY. Never use a VITE_ prefix.
# Create a key in Google AI Studio and put it here locally or in your host's secret settings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
BRAIN_MAX_QUEUE=30

# PostgreSQL is required for production task acceptance and restart recovery. Local development may omit it.
DATABASE_URL=
PGSSL=true

# Render management — monitoring works without these; mutations remain disabled in this build.
RENDER_API_KEY=
RENDER_SERVICE_ID=
ENABLE_RENDER_MUTATIONS=false
