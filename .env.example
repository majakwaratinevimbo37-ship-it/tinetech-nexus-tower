# API server
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WEBSITE_URL=https://tinetech.onrender.com

# Google Gemini API — SERVER ONLY. Never use a VITE_ prefix.
# Create a key in Google AI Studio and put it here locally or in your host's secret settings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
BRAIN_MAX_QUEUE=30

# Optional persistent storage (PostgreSQL). Leave unset for local in-memory development.
DATABASE_URL=
PGSSL=true

# Render management — monitoring works without these; mutations remain disabled in this build.
RENDER_API_KEY=
RENDER_SERVICE_ID=
ENABLE_RENDER_MUTATIONS=false
